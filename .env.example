# Copy this file to `.env` and fill in real values before deploying.

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

SITE_NAME=آرایشگاه متین

# --- SMS gateway (phone verification codes) ---------------------------------
# ConsoleSmsBackend just prints the code in the terminal/log, useful for
# development without an SMS account. Switch to Kavenegar (or any other
# provider by writing a small backend in accounts/sms/backends.py) for
# production.
SMS_BACKEND=accounts.sms.backends.ConsoleSmsBackend
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=verify

# --- ZarinPal payment gateway (appointment deposit) -------------------------
# Get a merchant id from https://www.zarinpal.com (sandbox ids work at
# https://sandbox.zarinpal.com for testing without real money).
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
# Public base URL used to build the ZarinPal callback link, e.g.
# https://example.com  (leave empty to auto-detect from the incoming request)
ZARINPAL_CALLBACK_BASE_URL=
