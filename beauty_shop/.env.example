# این فایل را با نام .env کپی کنید و مقادیر را تغییر دهید:  cp .env.example .env
# (فایل .env در گیت ذخیره نمی‌شود)

# ---------- عمومی ----------
DJANGO_DEBUG=True
# در سرور حتماً یک کلید طولانی و تصادفی بگذارید:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# مثال سرور: https://example.ir,https://www.example.ir
DJANGO_CSRF_TRUSTED_ORIGINS=
# آدرس پنل مدیریت (در سرور آن را به یک مسیر غیرقابل حدس تغییر دهید)
DJANGO_ADMIN_URL=admin/

# ---------- پایگاه داده ----------
# پیش‌فرض SQLite است. برای PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=beauty_shop
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ---------- پنل پیامکی ----------
# توسعه (کد در ترمینال چاپ می‌شود):
SMS_BACKEND=apps.accounts.sms.backends.ConsoleSMSBackend
# کاوه‌نگار:
# SMS_BACKEND=apps.accounts.sms.backends.KavenegarSMSBackend
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=verify
# اس‌ام‌اس.آی‌آر (sms.ir):
# SMS_BACKEND=apps.accounts.sms.backends.SmsIrSMSBackend
# SMSIR_API_KEY=
# SMSIR_OTP_TEMPLATE_ID=
# SMSIR_OTP_PARAMETER=CODE
# ملی‌پیامک:
# SMS_BACKEND=apps.accounts.sms.backends.MelipayamakSMSBackend
# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# MELIPAYAMAK_OTP_BODY_ID=

# تنظیمات کد تایید (ثانیه)
OTP_LENGTH=5
OTP_EXPIRE_SECONDS=120
OTP_RESEND_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=6
# در حالت DEBUG کد تایید روی صفحه هم نمایش داده می‌شود (در سرور خودکار غیرفعال است)
# OTP_SHOW_CODE_IN_MESSAGE=False

# ---------- درگاه پرداخت ----------
# fake = درگاه آزمایشی داخلی | zarinpal | zibal
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
# مرچنت «zibal» حالت تست زیبال است
ZIBAL_MERCHANT=zibal

# ---------- نقشه ----------
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------- سرور (Production) ----------
# پشت nginx، هدر IP واقعی کاربر (برای محدودیت ارسال پیامک):
# CLIENT_IP_HEADER=HTTP_X_REAL_IP
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_STATIC_MANIFEST=True
