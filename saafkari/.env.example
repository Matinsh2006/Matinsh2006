# ---------------------------------------------------------------------------
# این فایل را به نام ‎.env‎ کپی کنید و مقادیر را پر کنید.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- تنظیمات پایه ---------------------------------------------------------
DJANGO_SECRET_KEY=یک-کلید-تصادفی-بلند-اینجا-بگذارید
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# در حالت تولید، دامنه‌ی خود را بگذارید:
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- پنل پیامکی (کد تایید ورود و تغییر شماره) -----------------------------
# مقادیر مجاز: console | kavenegar | smsir | ghasedak
# حالت console فقط پیامک را در ترمینال چاپ می‌کند (مناسب توسعه).
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE=verify

OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_HOURLY_LIMIT=6

# --- درگاه پرداخت (بیعانه) ------------------------------------------------
# مقادیر مجاز: sandbox (درگاه آزمایشی داخلی) | zarinpal
PAYMENT_GATEWAY=sandbox
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
PAYMENT_CURRENCY=IRT

# --- آپلود عکس آگهی مشتری -------------------------------------------------
APPOINTMENT_MAX_PHOTOS=8
APPOINTMENT_MAX_PHOTO_SIZE_MB=5
