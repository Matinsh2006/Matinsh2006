# Copy this file to `.env` and fill in the values.

# --- Core -----------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
# Public address of the site; used to build payment callback URLs.
# SITE_URL=https://example.ir

# --- Database (SQLite by default) -----------------------------------------
# DB_ENGINE=postgres
# DB_NAME=watchshop
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- SMS panel for one-time codes ------------------------------------------
# console | kavenegar | smsir | melipayamak
SMS_BACKEND=console
# Kavenegar (pattern "verify/lookup"):
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
# SMS.ir (template "send/verify"):
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAM_NAME=CODE
# Melipayamak (shared service line with pattern):
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_OTP_BODY_ID=
# OTP_LENGTH=5
# OTP_TTL_SECONDS=120
# OTP_RESEND_SECONDS=60

# --- Payment gateways -------------------------------------------------------
# Enabled gateways (first = default): zarinpal, zibal, fake
PAYMENT_GATEWAYS=fake,zarinpal,zibal
# The fake gateway marks orders as paid without real money: development only!
PAYMENT_ALLOW_FAKE=True
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
# "zibal" is Zibal's public test merchant
ZIBAL_MERCHANT=zibal

# --- Map tiles for the store location ---------------------------------------
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Production ---------------------------------------------------------------
# SERVE_MEDIA=True          # let Django serve uploads when there is no nginx
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
