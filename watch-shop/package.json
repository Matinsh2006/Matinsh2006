{
  "name": "watch-shop-frontend",
  "private": true,
  "description": "Tailwind CSS and JavaScript build for the Django watch shop",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/css/app.css -o ./static/css/app.css --minify",
    "build:js": "node ./frontend/scripts/clean-js.mjs && esbuild ./frontend/js/app.js ./frontend/js/hero.js --bundle --format=esm --minify --target=es2020 --outdir=./static/js --legal-comments=none",
    "build:fonts": "node ./frontend/scripts/copy-assets.mjs",
    "build": "npm run build:fonts && npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./frontend/css/app.css -o ./static/css/app.css --watch",
    "watch:js": "esbuild ./frontend/js/app.js ./frontend/js/hero.js --bundle --format=esm --target=es2020 --outdir=./static/js --sourcemap --watch"
  },
  "devDependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/markazi-text": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "lenis": "^1.3.26",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  }
}
